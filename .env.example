# ─── Backend (Render) ────────────────────────────────────────────────────────

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Demo mode (opt-in, default OFF). DEMO_MODE=true runs the API with SIMULATED readings and
# in-memory appliances: no database, and appliance buttons do NOT control real relays.
# Never set this on the production service. See docs/DEMO_MODE.md
# DEMO_MODE=true

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
# Leave unset to allow all origins (development only)
CORS_ORIGIN=https://your-app.vercel.app

# ─── Frontend (Vercel) ───────────────────────────────────────────────────────

# Full URL of the Render backend (no trailing slash)
# Required on Vercel; leave unset for local development with a dev proxy
VITE_API_URL=https://your-api.onrender.com
